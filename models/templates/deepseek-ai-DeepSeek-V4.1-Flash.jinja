{%- if not add_generation_prompt is defined -%}
  {%- set add_generation_prompt = false -%}
{%- endif -%}
{%- if not thinking is defined -%}
  {%- if enable_thinking is defined -%}
    {%- set thinking = enable_thinking -%}
  {%- else -%}
    {%- set thinking = false -%}
  {%- endif -%}
{%- endif -%}
{%- if not drop_thinking is defined -%}
  {%- set drop_thinking = true -%}
{%- endif -%}
{%- set dsml_token = '｜DSML｜' -%}
{%- set thinking_start_token = '<think>' -%}
{%- set thinking_end_token = '</think>' -%}
{%- set system_sp_token = '<｜System｜>' -%}
{%- set image_placeholder = '<｜deepseek_image｜>' -%}
{%- set tc_block_name = ' calls' -%}
{%- set tool_call_tag_name = ' invoke' -%}
{%- set tool_parameter_tag_name = ' parameter' -%}
{%- set reasoning_effort_prefix = 'Reasoning Effort: ' -%}
{%- set reasoning_effort_suffix = ' (range 1-100, the higher the value, the more thorough the reasoning)\n\n' -%}
{%- set response_format_template = '## Response Format:\n\nYou MUST strictly adhere to the following schema to reply:\n' -%}
{%- set tools_header = '## Tools\n\nYou have access to a set of tools to help answer the user\'s question. You can invoke tools by writing a "<' + dsml_token + tc_block_name + '>" block like the following:\n\n<' + dsml_token + tc_block_name + '>\n<' + dsml_token + tool_call_tag_name + ' name="$TOOL_NAME">\n<' + dsml_token + tool_parameter_tag_name + ' name="$PARAMETER_NAME" string="true|false">$PARAMETER_VALUE</' + dsml_token + tool_parameter_tag_name + '>\n...\n</' + dsml_token + tool_call_tag_name + '>\n<' + dsml_token + tool_call_tag_name + ' name="$TOOL_NAME2">\n...\n</' + dsml_token + tool_call_tag_name + '>\n</' + dsml_token + tc_block_name + '>\n\nString parameters should be specified as is and set `string="true"`. For all other types (numbers, booleans, arrays, objects), pass the value in JSON format and set `string="false"`.\n\nIf thinking_mode is enabled (triggered by ' + thinking_start_token + '), you MUST output your complete reasoning inside ' + thinking_start_token + '...' + thinking_end_token + ' BEFORE any tool calls or final response.\n\nOtherwise, output directly after ' + thinking_end_token + ' with tool calls or final response.\n\n### Available Tool Schemas\n\n' -%}
{%- set tools_footer = '\nYou MUST strictly follow the above defined tool name and parameter schemas to invoke tool calls.\n' -%}
{%- macro render_tools(tool_list, header, footer) -%}
  {%- set ts = namespace(schemas='') -%}
  {%- for tool in tool_list -%}
    {%- if tool['type'] == 'function' -%}
      {%- set ts.schemas = ts.schemas + (tool['function'] | tojson) + '\n' -%}
    {%- endif -%}
  {%- endfor -%}
  {{- header + ts.schemas + footer -}}
{%- endmacro -%}
{%- macro render_content(content) -%}
  {%- if content is string -%}
    {{- content -}}
  {%- elif content -%}
    {%- for part in content -%}
      {%- if not loop.first -%}
        {{- '\n\n' -}}
      {%- endif -%}
      {%- if part['type'] == 'text' -%}
        {{- part['text'] or '' -}}
      {%- elif part['type'] == 'image' or part['type'] == 'image_url' -%}
        {{- image_placeholder -}}
      {%- elif part['type'] == 'media_marker' -%}
        {{- part['text'] or '' -}}
      {%- else -%}
        {{- '[Unsupported ' + part['type'] + ']' -}}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endmacro -%}
{%- set ns = namespace(has_tools=false, first_is_system=false, extra_system='') -%}
{%- if messages -%}
  {%- if messages[0]['role'] == 'system' -%}
    {%- set ns.first_is_system = true -%}
  {%- endif -%}
{%- endif -%}
{%- if tools is defined and tools -%}
  {%- set ns.has_tools = true -%}
{%- endif -%}
{%- for message in messages -%}
  {%- if message['tools'] is defined and message['tools'] -%}
    {%- set ns.has_tools = true -%}
  {%- endif -%}
{%- endfor -%}
{%- if not ns.first_is_system -%}
  {%- if tools is defined and tools -%}
    {%- set ns.extra_system = render_tools(tools, tools_header, tools_footer) -%}
  {%- endif -%}
  {%- if response_format is defined -%}
    {%- if ns.extra_system -%}
      {%- set ns.extra_system = ns.extra_system + '\n\n' -%}
    {%- endif -%}
    {%- set ns.extra_system = ns.extra_system + response_format_template + (response_format | tojson) -%}
  {%- endif -%}
{%- endif -%}
{%- set effort = namespace(value=75) -%}
{%- if reasoning_effort is defined and reasoning_effort is string -%}
  {%- if reasoning_effort == 'low' or reasoning_effort == 'minimal' -%}
    {%- set effort.value = 50 -%}
  {%- elif reasoning_effort == 'high' or reasoning_effort == 'medium' or reasoning_effort == 'default' -%}
    {%- set effort.value = 75 -%}
  {%- elif reasoning_effort == 'max' or reasoning_effort == 'xhigh' -%}
    {%- set effort.value = 100 -%}
  {%- elif (reasoning_effort | int(0)) >= 1 and (reasoning_effort | int(0)) <= 100 -%}
    {%- set effort.value = reasoning_effort | int(0) -%}
  {%- endif -%}
{%- elif reasoning_effort is defined and reasoning_effort is number and reasoning_effort >= 1 and reasoning_effort <= 100 -%}
  {%- set effort.value = reasoning_effort | int -%}
{%- endif -%}
{{- bos_token -}}
{%- if messages and thinking -%}
  {{- system_sp_token + reasoning_effort_prefix -}}
  {{- effort.value -}}
  {{- reasoning_effort_suffix -}}
{%- elif ns.first_is_system or ns.extra_system -%}
  {{- system_sp_token -}}
{%- endif -%}
{{- ns.extra_system -}}
{%- set last_user_idx = namespace(value=-1) -%}
{%- for message in messages -%}
  {%- if message['role'] == 'user' or message['role'] == 'developer' or message['role'] == 'tool' or (message['role'] == 'system' and loop.index0 > 0) -%}
    {%- set last_user_idx.value = loop.index0 -%}
  {%- endif -%}
{%- endfor -%}
{%- set state = namespace(in_user=false, has_tool_calls=false, gen_prompt_done=false) -%}
{%- for message in messages -%}
  {%- if message['role'] == 'tool' -%}
    {%- set state.has_tool_calls = true -%}
  {%- endif -%}
{%- endfor -%}
{%- for message in messages -%}
  {%- if message['role'] == 'system' -%}
    {%- set state.in_user = false -%}
    {%- if loop.index0 > 0 -%}
      {{- system_sp_token -}}
    {%- endif -%}
    {{- render_content(message['content']) -}}
    {%- if message['tools'] is defined and message['tools'] -%}
      {{- '\n\n' -}}
      {{- render_tools(message['tools'], tools_header, tools_footer) -}}
    {%- endif -%}
    {%- if loop.index0 == 0 -%}
      {%- if tools is defined and tools -%}
        {{- '\n\n' -}}
        {{- render_tools(tools, tools_header, tools_footer) -}}
      {%- endif -%}
      {%- if response_format is defined -%}
        {{- '\n\n' + response_format_template + (response_format | tojson) -}}
      {%- endif -%}
    {%- endif -%}
  {%- elif message['role'] == 'latest_reminder' -%}
    {%- set state.in_user = false -%}
    {{- '<｜latest_reminder｜>' -}}
    {{- render_content(message['content']) -}}
  {%- elif message['role'] == 'user' or message['role'] == 'developer' -%}
    {%- if state.in_user -%}
      {{- '\n\n' -}}
    {%- else -%}
      {{- '<｜User｜>' -}}
      {%- set state.in_user = true -%}
    {%- endif -%}
    {{- render_content(message['content']) -}}
    {%- if message['task'] is defined and message['task'] -%}
      {%- set emit_task = false -%}
      {%- if loop.last -%}
        {%- if add_generation_prompt -%}
          {%- set emit_task = true -%}
          {%- set state.gen_prompt_done = true -%}
        {%- endif -%}
      {%- elif loop.nextitem['role'] == 'assistant' -%}
        {%- set emit_task = true -%}
      {%- endif -%}
      {%- if emit_task -%}
        {%- set state.in_user = false -%}
        {%- if message['task'] == 'action' -%}
          {{- '<｜Assistant｜>' -}}
          {%- if thinking -%}
            {{- thinking_start_token -}}
          {%- else -%}
            {{- thinking_end_token -}}
          {%- endif -%}
        {%- endif -%}
        {{- '<｜' + message['task'] + '｜>' -}}
      {%- endif -%}
    {%- endif -%}
  {%- elif message['role'] == 'tool' -%}
    {%- if state.in_user -%}
      {{- '\n\n' -}}
    {%- else -%}
      {{- '<｜User｜>' -}}
      {%- set state.in_user = true -%}
    {%- endif -%}
    {{- '<tool_result>' -}}
    {{- render_content(message['content']) -}}
    {{- '</tool_result>' -}}
  {%- elif message['role'] == 'assistant' -%}
    {%- set state.in_user = false -%}
    {%- set prev_has_task = false -%}
    {%- if loop.index0 > 0 -%}
      {%- if loop.previtem['task'] is defined and loop.previtem['task'] -%}
        {%- set prev_has_task = true -%}
      {%- endif -%}
    {%- endif -%}
    {%- if not prev_has_task -%}
      {{- '<｜Assistant｜>' -}}
      {%- set is_after_last_user = loop.index0 > last_user_idx.value -%}
      {%- set keep_reasoning = thinking and ((not drop_thinking) or ns.has_tools or is_after_last_user or state.has_tool_calls) -%}
      {%- if keep_reasoning -%}
        {{- thinking_start_token -}}
        {%- if message['reasoning_content'] is defined and message['reasoning_content'] -%}
          {{- message['reasoning_content'] -}}
        {%- endif -%}
        {{- thinking_end_token -}}
      {%- else -%}
        {{- thinking_end_token -}}
      {%- endif -%}
    {%- endif -%}
    {%- if message['content'] is defined and message['content'] -%}
      {{- render_content(message['content']) -}}
    {%- endif -%}
    {%- if message['tool_calls'] -%}
      {{- '\n\n<' + dsml_token + tc_block_name + '>\n' -}}
      {%- for tool in message['tool_calls'] -%}
        {%- set func = tool['function'] -%}
        {{- '<' + dsml_token + tool_call_tag_name + ' name="' + func['name'] + '">\n' -}}
        {%- set args = func['arguments'] -%}
        {%- if args is string -%}
          {%- set args = args | from_json -%}
        {%- endif -%}
        {%- for key, val in args.items() -%}
          {%- if val is string -%}
            {{- '<' + dsml_token + tool_parameter_tag_name + ' name="' + key + '" string="true">' + val + '</' + dsml_token + tool_parameter_tag_name + '>\n' -}}
          {%- else -%}
            {{- '<' + dsml_token + tool_parameter_tag_name + ' name="' + key + '" string="false">' + (val | tojson) + '</' + dsml_token + tool_parameter_tag_name + '>\n' -}}
          {%- endif -%}
        {%- endfor -%}
        {%- if not args -%}
          {{- '\n' -}}
        {%- endif -%}
        {{- '</' + dsml_token + tool_call_tag_name + '>\n' -}}
      {%- endfor -%}
      {{- '</' + dsml_token + tc_block_name + '>' -}}
    {%- endif -%}
    {{- '<｜end▁of▁sentence｜>' -}}
  {%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt and not state.gen_prompt_done -%}
  {{- '<｜Assistant｜>' -}}
  {%- if thinking -%}
    {{- thinking_start_token -}}
  {%- else -%}
    {{- thinking_end_token -}}
  {%- endif -%}
{%- endif -%}
